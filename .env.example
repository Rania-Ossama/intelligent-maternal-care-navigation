# Copy this file to a new file named exactly  .env  (no .example) and paste your key after the =
# No quotes, no spaces.
TOMTOM_KEY=PASTE_YOUR_TOMTOM_KEY_HERE

# OPTIONAL: a second key (Map Display + Traffic only, domain whitelist ON) used by the browser
# for the map tiles. If you leave it out, TOMTOM_KEY is used for the tiles too.
# TOMTOM_MAP_KEY=PASTE_SECOND_KEY_HERE
